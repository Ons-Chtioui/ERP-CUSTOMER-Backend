<!-- src/emails/templates/quote.hbs -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Devis {{reference}}</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: Arial, sans-serif; font-size:14px; color:#1f2937; background:#f9fafb; }
    .wrapper { max-width:640px; margin:0 auto; padding:24px 16px; }
    .card { background:#ffffff; border-radius:10px; overflow:hidden;
            box-shadow:0 1px 4px rgba(0,0,0,0.08); }
    .header { background:#3B4EFF; padding:28px 32px; }
    .header h1 { color:#ffffff; font-size:22px; margin-bottom:4px; }
    .header p  { color:#c7d2fe; font-size:13px; }
    .body { padding:28px 32px; }
    .body p { margin-bottom:14px; line-height:1.6; }
    .badge { display:inline-block; background:#fef3c7; color:#92400e;
             border:1px solid #f59e0b; border-radius:6px;
             padding:4px 12px; font-size:13px; font-weight:600; }
    table { width:100%; border-collapse:collapse; margin:20px 0; font-size:13px; }
    thead th { background:#3B4EFF; color:#fff; padding:10px 12px;
               text-align:left; font-weight:600; }
    tbody tr:nth-child(even) { background:#f3f4f6; }
    tbody td { padding:9px 12px; border-bottom:1px solid #e5e7eb; }
    .total-section { border-top:2px solid #e5e7eb; padding-top:12px; margin-top:8px; }
    .total-row { display:flex; justify-content:space-between;
                 padding:4px 0; font-size:13px; }
    .total-row.main { font-size:16px; font-weight:700;
                      color:#3B4EFF; margin-top:6px;
                      padding-top:8px; border-top:2px solid #3B4EFF; }
    .btn { display:inline-block; background:#3B4EFF; color:#ffffff;
           text-decoration:none; padding:12px 24px; border-radius:8px;
           font-weight:600; font-size:14px; margin-top:20px; }
    .note { background:#f0f9ff; border-left:4px solid #0ea5e9;
            padding:12px 16px; border-radius:4px; margin-top:16px;
            font-size:13px; color:#0369a1; }
    .footer { padding:20px 32px; background:#f9fafb;
              border-top:1px solid #e5e7eb; font-size:12px; color:#6b7280;
              text-align:center; line-height:1.6; }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="card">
    <div class="header">
      <h1>Devis {{reference}}</h1>
      <p>{{companyName}}</p>
    </div>
    <div class="body">
      <p>Bonjour <strong>{{clientName}}</strong>,</p>
      <p>
        Veuillez trouver ci-dessous votre devis <strong>{{reference}}</strong>.<br>
        Ce devis est valable jusqu'au <span class="badge">{{validUntil}}</span>.
      </p>

      <table>
        <thead>
          <tr>
            <th>Désignation</th>
            <th style="text-align:right">Qté</th>
            <th style="text-align:right">PU HT</th>
            <th style="text-align:right">Total HT</th>
          </tr>
        </thead>
        <tbody>
          {{#each lines}}
          <tr>
            <td>{{this.productName}}</td>
            <td style="text-align:right">{{this.quantity}}</td>
            <td style="text-align:right">{{this.unitPrice}} TND</td>
            <td style="text-align:right"><strong>{{this.totalHt}} TND</strong></td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      <div class="total-section">
        <div class="total-row">
          <span>Total HT</span><span>{{totalHt}} TND</span>
        </div>
        <div class="total-row">
          <span>TVA</span><span>{{totalTva}} TND</span>
        </div>
        <div class="total-row main">
          <span>Total TTC</span><span>{{totalTtc}} TND</span>
        </div>
      </div>

      {{#if note}}
      <div class="note">📝 {{note}}</div>
      {{/if}}

      <a href="{{quoteUrl}}" class="btn">Voir le devis en ligne →</a>
    </div>
    <div class="footer">
      {{companyName}} — {{companyAddress}}<br>
      Ce document a été généré automatiquement. Merci de ne pas répondre à cet email.
    </div>
  </div>
</div>
</body>
</html>