<!-- src/emails/templates/reminder.hbs -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Relance de paiement - {{reference}}</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: Arial, sans-serif; font-size:14px; color:#1f2937; background:#f9fafb; }
    .wrapper { max-width:640px; margin:0 auto; padding:24px 16px; }
    .card { background:#fff; border-radius:10px; overflow:hidden;
            box-shadow:0 1px 4px rgba(0,0,0,0.08); }
    .header { background:#dc2626; padding:28px 32px; }
    .header h1 { color:#fff; font-size:22px; }
    .header p  { color:#fecaca; font-size:13px; margin-top:4px; }
    .body { padding:28px 32px; }
    .body p { margin-bottom:14px; line-height:1.6; }
    .alert { background:#fef2f2; border:1px solid #fca5a5; border-radius:8px;
             padding:14px 18px; margin-bottom:18px; color:#991b1b; font-size:13px; }
    table { width:100%; border-collapse:collapse; margin:16px 0; font-size:13px; }
    thead th { background:#dc2626; color:#fff; padding:10px 12px; text-align:left; }
    tbody tr:nth-child(even) { background:#fff5f5; }
    tbody td { padding:9px 12px; border-bottom:1px solid #fee2e2; }
    .total-row { display:flex; justify-content:space-between;
                 padding:4px 0; font-size:13px; }
    .total-row.main { font-size:16px; font-weight:700; color:#dc2626;
                      border-top:2px solid #dc2626; margin-top:6px; padding-top:8px; }
    .btn { display:inline-block; background:#dc2626; color:#fff;
           text-decoration:none; padding:12px 24px; border-radius:8px;
           font-weight:600; font-size:14px; margin-top:16px; }
    .footer { padding:20px 32px; background:#f9fafb;
              border-top:1px solid #e5e7eb; font-size:12px;
              color:#6b7280; text-align:center; }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="card">
    <div class="header">
      <h1>⚠️ Relance de paiement</h1>
      <p>{{companyName}}</p>
    </div>
    <div class="body">
      <p>Bonjour <strong>{{clientName}}</strong>,</p>

      <div class="alert">
        🔔 La facture <strong>{{reference}}</strong> est en attente de règlement
        depuis <strong>{{daysOverdue}} jour(s)</strong>.<br>
        Montant restant dû : <strong>{{amountDue}} TND</strong>
      </div>

      <table>
        <thead>
          <tr>
            <th>Description</th>
            <th style="text-align:right">Qté</th>
            <th style="text-align:right">PU HT</th>
            <th style="text-align:right">Total HT</th>
          </tr>
        </thead>
        <tbody>
          {{#each lines}}
          <tr>
            <td>{{this.description}}</td>
            <td style="text-align:right">{{this.quantity}}</td>
            <td style="text-align:right">{{this.unitPrice}} TND</td>
            <td style="text-align:right"><strong>{{this.totalHt}} TND</strong></td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      <div style="border-top:2px solid #e5e7eb; padding-top:12px;">
        <div class="total-row"><span>Total HT</span><span>{{totalHt}} TND</span></div>
        <div class="total-row"><span>TVA</span><span>{{totalTva}} TND</span></div>
        <div class="total-row main"><span>Total TTC</span><span>{{totalTtc}} TND</span></div>
        <div class="total-row" style="color:#dc2626;font-weight:600;font-size:14px;border-top:1px dashed #fca5a5;padding-top:6px;margin-top:4px;">
          <span>Restant dû</span>
          <span>{{remainingAmount}} TND</span>
        </div>
      </div>

      <div style="text-align:center;">
        <a href="{{paymentUrl}}" class="btn">💳 Payer maintenant</a>
      </div>

      <p style="margin-top:16px;font-size:13px;color:#6b7280;">
        Si vous avez déjà effectué le paiement, merci d'ignorer ce message.
      </p>
    </div>
    <div class="footer">
      {{companyName}} — {{companyAddress}}<br>
      Ce document a été généré automatiquement.
    </div>
  </div>
</div>
</body>
</html>