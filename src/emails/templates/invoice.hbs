<!-- src/emails/templates/invoice.hbs -->
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Facture {{reference}}</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: Arial, sans-serif; font-size:14px; color:#1f2937; background:#f9fafb; }
    .wrapper { max-width:640px; margin:0 auto; padding:24px 16px; }
    .card { background:#fff; border-radius:10px; overflow:hidden;
            box-shadow:0 1px 4px rgba(0,0,0,0.08); }
    .header { background:{{#if isReminder}}#dc2626{{else}}#10b981{{/if}}; padding:28px 32px; }
    .header h1 { color:#fff; font-size:22px; margin-bottom:4px; }
    .header p  { color:#d1fae5; font-size:13px; }
    .body { padding:28px 32px; }
    .body p { margin-bottom:14px; line-height:1.6; }
    .alert { background:#fef2f2; border:1px solid #fca5a5; border-radius:8px;
             padding:14px 18px; margin-bottom:18px; color:#991b1b; font-size:13px; }
    .info-grid { display:flex; gap:24px; margin-bottom:20px; }
    .info-box { flex:1; background:#f9fafb; border-radius:8px;
                padding:12px 16px; border:1px solid #e5e7eb; }
    .info-box label { font-size:11px; text-transform:uppercase;
                      letter-spacing:.05em; color:#6b7280; display:block;
                      margin-bottom:4px; }
    .info-box span  { font-weight:600; font-size:14px; }
    table { width:100%; border-collapse:collapse; margin:16px 0; font-size:13px; }
    thead th { background:#10b981; color:#fff; padding:10px 12px; text-align:left; }
    tbody tr:nth-child(even) { background:#f0fdf4; }
    tbody td { padding:9px 12px; border-bottom:1px solid #e5e7eb; }
    .total-row { display:flex; justify-content:space-between;
                 padding:4px 0; font-size:13px; }
    .total-row.main { font-size:16px; font-weight:700; color:#10b981;
                      border-top:2px solid #10b981; margin-top:6px; padding-top:8px; }
    .footer { padding:20px 32px; background:#f9fafb;
              border-top:1px solid #e5e7eb; font-size:12px;
              color:#6b7280; text-align:center; }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="card">
    <div class="header">
      <h1>{{#if isReminder}}Rappel de paiement{{else}}Facture {{reference}}{{/if}}</h1>
      <p>{{companyName}}</p>
    </div>
    <div class="body">
      <p>Bonjour <strong>{{clientName}}</strong>,</p>

      {{#if isReminder}}
      <div class="alert">
        ⚠️ La facture <strong>{{reference}}</strong> est en attente de règlement
        depuis <strong>{{daysOverdue}} jour(s)</strong>.<br>
        Montant restant dû : <strong>{{amountDue}} TND</strong>
      </div>
      {{else}}
      <p>Veuillez trouver ci-dessous votre facture <strong>{{reference}}</strong>.</p>
      {{/if}}

      <div class="info-grid">
        {{#if dueDate}}
        <div class="info-box">
          <label>Date d'échéance</label>
          <span>{{dueDate}}</span>
        </div>
        {{/if}}
        <div class="info-box">
          <label>Total TTC</label>
          <span>{{totalTtc}} TND</span>
        </div>
      </div>

      <table>
        <thead>
          <tr>
            <th>Description</th>
            <th style="text-align:right">Qté</th>
            <th style="text-align:right">PU HT</th>
            <th style="text-align:right">Total HT</th>
          </tr>
        </thead>
        <tbody>
          {{#each lines}}
          <tr>
            <td>{{this.description}}</td>
            <td style="text-align:right">{{this.quantity}}</td>
            <td style="text-align:right">{{this.unitPrice}} TND</td>
            <td style="text-align:right"><strong>{{this.totalHt}} TND</strong></td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      <div style="border-top:2px solid #e5e7eb; padding-top:12px;">
        <div class="total-row"><span>Total HT</span><span>{{totalHt}} TND</span></div>
        <div class="total-row"><span>TVA</span><span>{{totalTva}} TND</span></div>
        <div class="total-row main"><span>Total TTC</span><span>{{totalTtc}} TND</span></div>
      </div>
    </div>
    <div class="footer">
      {{companyName}} — Document généré automatiquement.
    </div>
  </div>
</div>
</body>
</html>